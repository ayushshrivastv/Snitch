RESEND_API_KEY=
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_RPC_URL=
NEXT_PUBLIC_ETHEREUM_TREASURY_ADDRESS=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Server-only libSQL database for Vercel. Leave blank for local SQLite development.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public site origin used for hosted checkout links.
SNITCH_PUBLIC_ORIGIN=https://snitchpay.vercel.app

# Local company metadata defaults to .data/snitch.sqlite.
# A persistent Node host can use an absolute directory; never use local files on Vercel.
# SNITCH_DATA_DIR=/var/lib/snitch
