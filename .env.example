RESEND_API_KEY=
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHEREUM_RPC_URL=
NEXT_PUBLIC_ETHEREUM_TREASURY_ADDRESS=
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Optional frontend-to-backend proxy. Set this on Vercel to the HTTPS origin of
# the same application running on a persistent Node service (for example Render).
SNITCH_API_ORIGIN=

# Public site origin used when the backend creates hosted checkout links.
SNITCH_PUBLIC_ORIGIN=

# Company metadata uses .data/snitch.sqlite locally (Node.js 22.14+).
# Production requires an absolute directory on a persistent volume.
# SNITCH_DATA_DIR=/var/lib/snitch
